{
  "name": "pretzel",
  "version": "0.1.0",
  "description": "Pretzel by ciyo.ai — AI prompt DLP monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --dir extension dev",
    "build": "pnpm --dir extension build",
    "test": "pnpm --dir extension test",
    "test:watch": "pnpm --dir extension test:watch",
    "typecheck": "pnpm --dir extension typecheck",
    "lint": "pnpm --dir extension lint",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:admin": "playwright test --config playwright.config.ts --project=admin",
    "test:e2e:extension": "playwright test --config playwright.config.ts --project=extension",
    "db:setup": "node scripts/db-setup.mjs",
    "check-db": "node scripts/check-db.mjs"
  },
  "devDependencies": {
    "@clerk/testing": "^1.4.4",
    "@playwright/test": "^1.47.0",
    "dotenv": "^16.4.5",
    "wait-on": "^8.0.1"
  }
}
