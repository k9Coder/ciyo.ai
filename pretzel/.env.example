# For local vite dev without --mode: copy this to .env and fill in values.
# Or use: pnpm dev:staging / pnpm build:staging (loads .env.staging directly).
VITE_API_BASE=http://localhost:3000
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_SENTRY_DSN_EXTENSION=          # Sentry → pretzel-extension project → Settings → Client Keys
