# Local dev: copy to .env (or run: pnpm set-env:staging from monorepo root).
#
# PRETZEL_API_URL is BAKED into the main-process bundle at build time
# (electron.vite.config.ts `define`), NOT read at runtime. Two consequences:
#   1. Changing it requires a REBUILD (`pnpm build`) — restarting the app or
#      setting a shell env var does nothing; the old value stays inlined.
#   2. The var name must be exactly PRETZEL_API_URL. A typo (e.g. a stale
#      CIYO_API_URL) silently leaves the default baked in, so sign-in points at
#      the wrong backend. Build one bundle per channel (dev/staging/prod).
PRETZEL_API_URL=http://localhost:3000
CLERK_PUBLISHABLE_KEY=pk_test_...
