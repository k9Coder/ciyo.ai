{
  // --- Your Original UI & UX Preferences ---
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.fontSize": 14,
  "editor.fontFamily": "Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "explorer.confirmDragAndDrop": false,
  "editor.bracketPairColorization.enabled": true,
  "explorer.compactFolders": true,
  "workbench.colorTheme": "Dark+",
  "explorer.confirmPasteNative": false,
  // --- Crucial AI & Performance Optimizations ---
  // Prevents Claude and VS Code from fighting over a file at the exact same millisecond.
  // "onFocusChange" or a longer delay ensures the AI finishes its thought before a format/save triggers.
  "files.autoSave": "onFocusChange",
  "editor.formatOnSave": true,
  // Aggressive exclusions to stop the AI from scanning heavy build, dependency, or binary folders.
  // This keeps Claude fast and prevents it from wasting tokens reading compiled data.
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/thumbs.db": true,
    "**/node_modules": true,
    "**/bower_components": true,
    "**/dist": true,
    "**/build": true,
    "**/.poetry": true,
    "**/.venv": true,
    "**/venv": true,
    "**/env": true,
    "**/.pytest_cache": true,
    "**/__pycache__": true
  },
  // Prevents VS Code from wasting CPU cycles indexing these files for search,
  // which frees up processing power for the AI terminal/extension on Windows.
  "search.useIgnoreFiles": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/venv": true,
    "**/.venv": true,
    "**/__pycache__": true
  },
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#1e1e2e",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.inactiveBackground": "#181825",
    "titleBar.inactiveForeground": "#a6adc8",
  },
  // Ensures terminal operations run smoothly without hitting Windows-specific path limits
  "terminal.integrated.windowsEnableConpty": true
}