# Switch environments with: pnpm set-env:staging | pnpm set-env:prod (from monorepo root)
# Or fill this file directly for local dev.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/promptshield
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
# Required (>=32 chars in production) — gates the /internal/* mesh.
INTERNAL_SECRET=dev-internal-secret-32chars-minimum-xxx
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYPAL_SKIP_SIG_VERIFY=false
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=...
SMTP_PASS=...
SMTP_FROM=noreply@promptshield.dev
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Where pretzel-desktop's OAuth handoff (/auth/desktop/authorize) redirects
# the system browser to sign in — must be a running, reachable console.
# Defaults to production if unset, which breaks local desktop sign-in.
PRETZEL_CONSOLE_URL=http://localhost:5173
LLM_PROVIDER=groq
GROQ_API_KEY=...
ANTHROPIC_API_KEY=...
OPENAI_API_KEY=...
APP_ENV=
