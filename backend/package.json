{
  "name": "pretzel-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx/esm --watch src/index.ts",
    "dev:debug": "node --inspect --env-file=.env --import tsx/esm --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:setup": "node scripts/db-setup.mjs",
    "check-db": "node scripts/check-db.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:e2e": "tsx src/scripts/seed-e2e.ts",
    "teardown:e2e": "tsx src/scripts/teardown-e2e.ts",
    "seed:fintech": "tsx --env-file=.env src/scripts/seed-fintech.ts",
    "seed:templates": "tsx --env-file=.env src/db/seeds/run-profession-templates.ts",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@clerk/backend": "^3.4.9",
    "@fastify/cors": "^9.0.1",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.30.10",
    "fastify": "^4.28.0",
    "fastify-plugin": "^5.1.0",
    "nodemailer": "^6.9.13",
    "openai": "^6.39.1",
    "postgres": "^3.4.4",
    "safe-regex2": "^5.1.1",
    "stripe": "^14.21.0",
    "svix": "^1.93.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^6.4.15",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.21.4",
    "supertest": "^7.0.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
