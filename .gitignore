node_modules/
dist/
*.local
.env
.DS_Store
.superpowers/
.worktrees/

# Themis research model weights — large binary, not checked into git.
# README.md + the training/eval scripts alongside it are tracked (the
# reproducible evidence for the CONTENT_CLAIMS.md entry); the weights
# themselves stay local-only.
models/themis/*.onnx
models/themis/*.onnx.data
models/themis/__pycache__/
# Intermediate training artifacts (also large binaries) — regenerable via
# `python prepare_vocab_pruned_backbone.py` then `python train.py`, per the
# README's "Reproducing this" section. Not the reproducible evidence itself
# (that's the tracked scripts/datasets); just scratch state.
models/themis/deberta_vocab_pruned_backbone/
models/themis/deberta-v3-small-vocabpruned-ft/
models/themis/deberta-v3-small-FULLVOCAB-diagnostic-ft/

# Themis model + ONNX Runtime Web WASM binaries bundled into the extension
# for the local-judge PoC (spike/local-judge-poc) — copied from models/themis/
# and from the onnxruntime-web package respectively, both local-only for the
# same reason as above. See pretzel/src/offscreen/themis-judge.ts for the
# exact source paths/commands to regenerate them.
pretzel/public/models/
pretzel/public/ort/

# Themis model bundled for the desktop local-judge PoC, same reasoning and
# regeneration source as pretzel/public/models/ above.
pretzel-desktop/resources/models/

# Prod env files across all packages — contain real secrets
# .env.staging files are safe to commit (test keys only)
**/.env.prod
**/.env.production

# E2E
e2e/.auth/
e2e/.seed-state.json
e2e/.env.e2e
e2e/test-results/
e2e/playwright-report/
admin/.auth/
admin/e2e/test-results/
admin/e2e/playwright-report/
backend/e2e/test-results/
backend/e2e/playwright-report/
extension/e2e/test-results/
extension/e2e/playwright-report/

# Desktop build/test artifacts
pretzel-desktop/dist-electron/
pretzel-desktop/test-results/
pretzel-desktop/release/

# gstack QA screenshot dumps — disposable, re-generated every run
**/.gstack-qa-shots/

# QA
qa/.auth/
qa/.env.qa.staging
qa/.env.qa.prod
qa/test-results/
qa/playwright-report/
# Only jira-tickets.md files out of .gstack/qa-reports/ are tracked — those
# are the paste-ready findings worth keeping. SUMMARY.md, qa-report-*.md,
# screenshots, baseline.json etc. are disposable/re-generated every run.
.gstack/*
!.gstack/qa-reports/
.gstack/qa-reports/**/*
!.gstack/qa-reports/**/
!.gstack/qa-reports/**/jira-tickets.md
.gstack/qa-reports/**/screenshots/
.gstack/
.gstack/
